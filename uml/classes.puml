@startuml
skinparam classAttributeIconSize 0

class Main {
    + {static} main(args: String[]): void
}

class Menu {
    - scanner: Scanner
    - emExecucao: boolean
    - jogador: Jogador
    - cidade: Cidade

    + executar(): void
    - exibirOpcoes(): void
    - lerOpcao(): int
    - processarOpcao(opcao: int): void
    - iniciarNovoJogo(): void
    - exibirSobre(): void
}

class Jogador {
    - nome: String
    - titulo: String

    + Jogador(nome: String)
    + getNome(): String
    + getTitulo(): String
}

class Cidade {
    - nome: String
    - anoAtual: int
    - dono: Jogador

    + Cidade(nome: String, dono: Jogador)
    + avancarAno(): void
    + exibirStatus(): void
}

Main ..> Menu : cria e usa
Menu --> "0..1" Jogador : jogador
Menu --> "0..1" Cidade : cidade
Cidade --> "1" Jogador : dono

@enduml